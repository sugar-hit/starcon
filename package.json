{
  "name": "starcon",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Enterprise SaaS ERP for cross-border e-commerce",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "bootstrap": "pnpm install && pnpm run build:packages",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "test": "pnpm test:unit",
    "test:e2e": "playwright test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "./deploy/scripts/catalog-db-sync.sh",
    "db:generate": "./deploy/scripts/catalog-db-generate.sh",
    "cli": "pnpm --filter @starcon/cli start",
    "release": "changeset publish",
    "prepare": "husky install || true",
    "test:unit": "vitest run",
    "dev:backend": "./deploy/scripts/catalog-dev.sh",
    "test:backend": "./deploy/scripts/backend-test.sh",
    "contracts:generate": "python3 tools/codegen/catalog-contracts.py",
    "test:codegen": "python3 -m unittest discover -s tools/codegen -p 'test_*.py'",
    "progress:sync": "node tools/module-progress/sync.mjs",
    "progress:check": "node tools/module-progress/sync.mjs --check",
    "progress:lock": "node tools/module-progress/lock.mjs",
    "test:workflow": "node tools/module-progress/test-workflow.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.11.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.27",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11",
    "braces": "3.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "source-map-js": "^1.2.2",
      "glob@10.3.10": "^10.5.0"
    },
    "patchedDependencies": {
      "braces@3.0.3": "patches/braces@3.0.3.patch"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-93687"
      ]
    }
  }
}
