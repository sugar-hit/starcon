# ============================================================
# starcon .gitignore
# 源码进仓库，产物全部本地化
# ============================================================

# Dependencies
node_modules/
.pnpm-store/

# Build outputs (产物 — 不进仓库)
dist/
build/
out/
*.tsbuildinfo
.next/
.turbo/
.cache/
.tmp/

# Generated code (regenerate via codegen)
**/src/generated/
**/src/codegen/
apps/api/src/platform-connectors/**/generated/

# Coverage & test artifacts
coverage/
.nyc_output/
*.lcov

# Environment files
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / IDE
.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# OS
.DS_Store
.Trashes
.Spotlight-V100
.AppleDouble
.LSOverride

# Deployment artifacts (镜像/构建产物)
deploy/artifacts/*
!deploy/artifacts/.gitkeep
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfvars
!infra/terraform/*.tfvars.example

# Helm
infra/helm/**/*.tgz

# Local databases / volume mounts
*.sqlite
*.sqlite-journal
data/
.postgres-data/

# Misc
.pnpm-debug.log*
.history/

# Local screenshots (auto-generated by chrome --headless, not committed)
.tmp-screenshots/
# Scheduler/agent scratch files written to the repo root during a tick.
# .tmp/ (directory) is already ignored; these bare .tmp-*.txt / .tmp_*.txt
# siblings are NOT covered by it and kept leaking into commits.
.tmp-*.txt
.tmp_*.txt
# Local development scratch and test artifacts
work/
playwright-report/
test-results/
# Editor/manual backups and captured session cookies — never commit credentials
*.bak
.dev-cookie.txt

# Java/Maven generated output
backend/**/target/

# Python 字节码 — codegen 的单测用 importlib 加载 tools/codegen/catalog-contracts.py，
# 跑一次 `pnpm test:codegen` 就会生成它。不忽略的话，脏工作区会挡住 lane.mjs land，
# 也可能被 `git add -A` 误提交进版本库。
# tools/module-progress/json-format.py 由 python3 执行
__pycache__/
*.py[cod]

# 定时开发任务的互斥锁与运行痕迹 — 本机状态，不进版本库
.dev-agent/

# 并行车道的独立 worktree（tools/module-progress/lane.mjs 管理）
.worktrees/

# 进度看板构建产物
tools/progress-site/.shots/
