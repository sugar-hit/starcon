FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY backend ./backend
RUN --mount=type=cache,target=/root/.m2 mvn -f backend/pom.xml -B -ntp -DskipTests package
FROM eclipse-temurin:21-jre
ARG SERVICE
WORKDIR /app
COPY --from=build /workspace/backend/services/${SERVICE}/target/${SERVICE}-0.1.0-SNAPSHOT.jar /app/service.jar
RUN mkdir -p /app/data/media /app/data/channel-secrets \
    && chown -R 10001:10001 /app/data \
    && chmod 750 /app/data/media \
    && chmod 700 /app/data/channel-secrets
USER 10001
ENTRYPOINT ["java", "-jar", "/app/service.jar"]
