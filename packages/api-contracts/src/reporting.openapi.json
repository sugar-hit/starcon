    "/reporting/projection/events": {
      "post": {
        "description": "同一事件重复投递会被幂等跳过（reporting_projection_event 的唯一键），投影不会翻倍。事件体里**没有** tenantId：租户由已认证成员关系解析。",
        "operationId": "post_reporting_projection_events",
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "required": false,
            "schema": {
              "default": "",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/ProjectionEvent"
                },
                "type": "array"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectionBatchResult"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "摄取一批规范化事件（投影主路径）",
        "tags": [
          "13.1.1.1 经营总览 · 投影摄取"
        ]
      }
    },
    "/reporting/projection/rebuild": {
      "post": {
        "description": "只清投影（事实 + 构成明细 + 游标），**不碰业务事实** —— 业务事实在上游服务那边。清空后重放同一批事件即可回到同一状态。⚠️ **事件账本不清**：账本是举证凭据，DB 层 REVOKE 了 UPDATE/DELETE，删不动；「这批事件投过了」这件事靠**重建纪元 +1** 抹掉（同一 source_event_id 在新纪元里是一条全新的账本行），所以旧账本原样留着当上一轮投过什么的证据。",
        "operationId": "post_reporting_projection_rebuild",
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "required": false,
            "schema": {
              "default": "",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "timezone",
            "required": false,
            "schema": {
              "default": "UTC",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RebuildResult"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "清空投影并重新拉取（可重建性）",
        "tags": [
          "13.1.1.1 经营总览 · 投影摄取"
        ]
      }
    },
    "/reporting/projection/refresh": {
      "post": {
        "description": "来源取值：trade-orders / trade-returns / channel-ads / finance-receivables / finance-cost / finance-profit / warehouse-inventory / catalog-rates。任一来源读不到时**那一路失败**（503），不会用空集合冒充「上游没有数据」。",
        "operationId": "post_reporting_projection_refresh",
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "required": false,
            "schema": {
              "default": "",
              "type": "string"
            }
          },
          {
