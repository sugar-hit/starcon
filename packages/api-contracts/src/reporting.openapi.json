  "paths": {
    "/reporting/overview": {
      "get": {
        "description": "时间范围与维度选择都在这里。默认窗口是「最近 30 天」。维度取值 COMPANY / LEGAL_ENTITY / SHOP；给了 shopId / legalEntityId 时维度会跟着收窄。",
        "operationId": "get_reporting_overview",
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "required": false,
            "schema": {
              "default": "",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "scopeType",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "legalEntityId",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "shopId",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "baseCurrency",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OverviewResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "经营总览：指标卡 + 趋势 + 异常提示 + 数据更新时间戳",
        "tags": [
          "13.1.1.1 经营总览"
        ]
      }
    },
    "/reporting/overview/capabilities": {
      "get": {
        "description": "上游列表按**本服务真的读过的授权只读 API**列出（不是「蓝图上写着上游」）；notDelivered 列出的是**确实拿不到**的部分，每条都写清原因与影响。",
        "operationId": "get_reporting_overview_capabilities",
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "required": false,
            "schema": {
              "default": "",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ReportingOverviewCapabilities"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "能力声明：哪些上游真接通、哪些还没交付、归谁",
        "tags": [
          "13.1.1.1 经营总览"
        ]
      }
    },
