            "minLength": 0,
            "type": "string"
          },
          "shopCode": {
            "maxLength": 64,
            "minLength": 0,
            "type": "string"
          },
          "status": {
            "maxLength": 16,
            "minLength": 0,
            "type": "string"
          },
          "verifiedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "sourceReference": {
            "maxLength": 128,
            "minLength": 0,
            "type": "string"
          },
          "note": {
            "maxLength": 400,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "McfSaved": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "platformCode": {
            "type": "string"
          },
          "shopCode": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "AUTHORIZED",
              "DENIED",
              "PENDING",
              "UNKNOWN"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "RoutingEvaluationRequest": {
        "required": [
          "orderRef",
          "platformCode",
          "requestedQty",
          "shopCode",
          "skuRef"
        ],
        "type": "object",
        "properties": {
          "orderRef": {
            "maxLength": 64,
            "minLength": 0,
            "type": "string"
          },
          "orderLineRef": {
            "maxLength": 64,
            "minLength": 0,
            "type": "string"
          },
          "platformCode": {
            "maxLength": 32,
            "minLength": 0,
            "type": "string"
          },
          "shopCode": {
            "maxLength": 64,
            "minLength": 0,
            "type": "string"
          },
          "skuRef": {
