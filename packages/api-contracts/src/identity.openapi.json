  "components": {
    "schemas": {
      "RoleInput": {
        "required": ["code", "name", "permissions", "status"],
        "type": "object",
        "properties": {
          "code": {
            "minLength": 1,
            "pattern": "[A-Z][A-Z0-9_-]{0,63}",
            "type": "string"
          },
          "name": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "status": {
            "pattern": "ACTIVE|INACTIVE",
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "minLength": 1,
              "type": "string"
            }
          }
        }
      },
      "AssignmentInput": {
        "required": ["roleId", "scopeMode"],
        "type": "object",
        "properties": {
          "roleId": {
            "type": "string",
            "format": "uuid"
          },
          "scopeMode": {
            "pattern": "ALL|DEPARTMENT|SELF",
            "type": "string"
          }
        }
      },
      "MemberUpdate": {
        "required": ["assignments", "status"],
        "type": "object",
        "properties": {
          "status": {
            "pattern": "ACTIVE|INACTIVE",
            "type": "string"
          },
          "departmentId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "assignments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssignmentInput"
            }
          }
        }
      },
      "DepartmentInput": {
        "required": ["name"],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "ChildUpdate": {
        "required": ["name", "status"],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "status": {
            "pattern": "ACTIVE|SUSPENDED",
            "type": "string"
          }
        }
      },
      "OwnerTransfer": {
        "required": ["membershipId"],
        "type": "object",
        "properties": {
          "membershipId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "MemberInput": {
        "required": ["assignments", "status", "username"],
        "type": "object",
        "properties": {
          "username": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "password": {
            "maxLength": 72,
            "minLength": 12,
            "type": "string",
            "nullable": true
          },
          "status": {
            "pattern": "ACTIVE|INACTIVE",
            "type": "string"
          },
          "departmentId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "assignments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssignmentInput"
            }
          }
        }
      },
      "ChildInput": {
        "required": ["code", "name", "ownerUsername"],
        "type": "object",
        "properties": {
          "code": {
            "minLength": 1,
            "pattern": "[A-Z][A-Z0-9_-]{0,63}",
            "type": "string"
          },
          "name": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "ownerUsername": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "ownerPassword": {
            "maxLength": 72,
            "minLength": 12,
            "type": "string",
            "nullable": true
          }
        }
      },
      "SwitchMembership": {
        "required": ["membershipId"],
        "type": "object",
        "properties": {
          "membershipId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Login": {
        "required": ["password", "username"],
        "type": "object",
        "properties": {
          "username": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          },
          "membershipId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        }
      },
      "LoginResult": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "nullable": true
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Membership"
            }
          }
        }
      },
      "Membership": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Access": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "tenantName": {
            "type": "string"
          },
          "membershipId": {
            "type": "string",
            "format": "uuid"
          },
          "departmentId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "grants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Grant"
            }
          }
        }
      },
      "Grant": {
        "type": "object",
        "properties": {
          "roleId": {
            "type": "string",
            "format": "uuid"
          },
          "roleCode": {
            "type": "string"
          },
          "scopeMode": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "RoleView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "system": {
            "type": "boolean"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PermissionView": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "pageCode": {
            "type": "string"
          },
          "pageName": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        }
      },
      "MemberView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "departmentId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "assignments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssignmentInput"
            }
          },
          "owner": {
            "type": "boolean"
          }
        }
      },
      "DepartmentView": {
        "type": "object",
