# ============================================================
# starcon .env.example
# 复制为 .env 后填实际值。.env 已被 .gitignore。
# ============================================================

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=debug
APP_PORT=3000

# --- Database (Postgres primary) ---
DATABASE_URL=postgresql://starcon:change-me-in-dev@localhost:5432/starcon
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# --- Local dev infrastructure (deploy/docker/docker-compose.dev.yml) ---
# 🔴 这两个口令只服务于**本地开发**基础设施（Postgres / MinIO）。
#    占位值仅供占位：scripts/bootstrap.sh 首次生成 .env 时会换成随机口令，
#    缺失时 compose 直接报错退出（`${VAR:?…}` 语义），不会悄悄用默认值。
DEV_POSTGRES_PASSWORD=change-me-in-dev
DEV_MINIO_ROOT_PASSWORD=change-me-in-dev

# --- Cache (Redis) ---
REDIS_URL=redis://localhost:6379

# --- Message Queue (Kafka) ---
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=starcon

# --- Object Storage (S3-compatible: AWS S3 / MinIO / Aliyun OSS) ---
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=starcon-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Auth ---
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=7d

# --- Multi-tenant ---
DEFAULT_TENANT_ISOLATION=row-level-security

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_DSN=

# --- Platform Connectors (各平台 API key) ---
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=
AMAZON_SP_API_REFRESH_TOKEN=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
EBAY_APP_ID=
EBAY_CERT_ID=
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=

# --- Payment Gateways ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
STRIPE_SECRET_KEY=
PINGPONG_CLIENT_ID=
PINGPONG_CLIENT_SECRET=
WORLDFIRST_API_KEY=

# --- Notification ---
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=